# Copia este archivo a `.env` y rellena los valores.

# Base de datos (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/electric_kar?schema=public"

# Aplicación
PORT=3000
NODE_ENV=development

# Autenticación (JWT)
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="7d"

# Datos fiscales del emisor (CFDI 4.0 · SAT)
EMISOR_RFC="EKA210345XY8"
EMISOR_REGIMEN="601"
IVA_TASA="16"
# Clave maestra para cifrar el CSD (llave privada + contraseña) en reposo.
# Usá un valor largo y aleatorio; NO la subas al repo.
CSD_MASTER_KEY=""

# Facturación full-service vía Facturapi (el PAC arma, sella y timbra).
# El CSD vive en Facturapi; acá solo van las API keys. NO commitear valores reales.
FACTURAPI_MODE="test"        # test | live
FACTURAPI_TEST_KEY=""        # sk_test_...
FACTURAPI_LIVE_KEY=""        # sk_live_... (solo producción)

# Frontend (URLs de retorno de Stripe)
APP_FRONT_URL="http://localhost:4200"

# Stripe (tarjeta, OXXO; SPEI requiere bank transfers) — dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Google OAuth (login con Google) — console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""

# Buscador (Typesense) — servicio del docker-compose en la raíz del repo
TYPESENSE_HOST="localhost"
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=dev_local_key
